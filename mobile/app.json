{
  "expo": {
    "name": "Popdate",
    "slug": "popdate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "popdate",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.goodn8s.popdate",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B2527",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.goodn8s.popdate"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDFE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "de", "fr", "it"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Popdate opens your photo library so you can pick the photos for your profile.",
          "cameraPermission": "Popdate uses the camera to take a selfie that verifies your photos are really you.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Popdate uses the camera to take a selfie that verifies your photos are really you.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-image",
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Popdate uses the microphone to record voice messages you send to your matches."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6d969a16-8f03-40b0-ab56-6b10f2695343"
      }
    },
    "owner": "goodn8s-team"
  }
}
